{
    "name": "@rig/electric",
    "version": "0.1.0",
    "type": "module",
    "sideEffects": false,
    "description": "Live-sync collections over a rig application's shape endpoints",
    "license": "MIT",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@electric-sql/client": "1.5.24",
        "@tanstack/db": "0.6.17",
        "@tanstack/electric-db-collection": "0.3.15"
    },
    "peerDependencies": {
        "@rig/client": "workspace:^"
    },
    "devDependencies": {
        "@rig/client": "workspace:*",
        "tsdown": "0.21.10",
        "typescript": "5.9.3"
    }
}
