{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "types": [],
        // Stricter than tsconfig.base.json on purpose, and it is here for the
        // generated output: it stands in for the tsconfig that output actually
        // lands under. rig scaffolds no front end, so that file is always
        // somebody else's, and Vite's react-ts template — with the TanStack
        // ones on top of it — turns this on. Anything it catches there is a
        // TS6133 in a file whose banner tells a project not to edit it, which
        // is the one kind of error they cannot fix where it lands.
        //
        // It reaches the hand-written packages as well, because the paths below
        // put their sources in this program. That is how the fixture is built
        // rather than a rule anybody chose for them, and a TS6133 in
        // ts/packages is answered the way the generator answers one: underscore
        // the binding.
        "noUnusedParameters": true,
        // Mapped rather than resolved through node_modules. The files being
        // checked live outside this directory, so TypeScript would look for
        // node_modules beside them and walk up out of the workspace — and
        // pointing at src rather than dist means this checks what the packages
        // say now, not what they said at the last build.
        "baseUrl": ".",
        "paths": {
            "@rig-ts/client": ["../packages/client/src/index.ts"],
            "@rig-ts/electric": ["../packages/electric/src/index.ts"],
            "@rig-ts/presence": ["../packages/presence/src/index.ts"],
            "@rig-ts/presence/react": ["../packages/presence/src/react.ts"]
        }
    },
    // The generator's own output, rather than a copy of it. A copy is a second
    // thing to update, and the run where somebody forgets is the run where this
    // stops checking anything.
    //
    // Five of them, because they fail differently. The three golden directories
    // are small schemas chosen to exercise the emitter, and they move whenever
    // the emitter does — `lifecycle` for the versioning and streaming surface,
    // `files` for the multipart one, which is the half of a method the compiler
    // is the only thing that checks, and `notify` for the tables a rig module
    // brings with it, which stream without declaring params and so bind a name
    // their bodies never read. The two example directories are real projects
    // with files, relations and an authentication foundation, regenerated by
    // `make examples` from a live Postgres — so they are what notices a compiler
    // the generator has never been run against.
    "include": [
        "src",
        "../../internal/gen/tsclient/testdata/lifecycle",
        "../../internal/gen/tsclient/testdata/files",
        "../../internal/gen/tsclient/testdata/notify",
        "../../examples/todo/client-ts",
        "../../examples/linearlite/web/src/api"
    ]
}
