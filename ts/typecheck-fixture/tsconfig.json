{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "types": [],
        // Mapped rather than resolved through node_modules. The files being
        // checked live outside this directory, so TypeScript would look for
        // node_modules beside them and walk up out of the workspace — and
        // pointing at src rather than dist means this checks what the packages
        // say now, not what they said at the last build.
        "baseUrl": ".",
        "paths": {
            "@rig-ts/client": ["../packages/client/src/index.ts"],
            "@rig-ts/electric": ["../packages/electric/src/index.ts"],
            "@rig-ts/presence": ["../packages/presence/src/index.ts"],
            "@rig-ts/presence/react": ["../packages/presence/src/react.ts"]
        }
    },
    // The generator's own output, rather than a copy of it. A copy is a second
    // thing to update, and the run where somebody forgets is the run where this
    // stops checking anything.
    //
    // Three of them, because they fail differently. The two golden directories
    // are small schemas chosen to exercise the emitter, and they move whenever
    // the emitter does — `lifecycle` for the versioning and streaming surface,
    // `files` for the multipart one, which is the half of a method the compiler
    // is the only thing that checks. examples/todo is a real project with files,
    // relations and an authentication foundation, and it is regenerated by `make
    // examples` from a live Postgres — so it is the one that notices a compiler
    // the generator has never been run against.
    "include": [
        "src",
        "../../internal/gen/tsclient/testdata/lifecycle",
        "../../internal/gen/tsclient/testdata/files",
        "../../examples/todo/client-ts",
        "../../examples/linearlite/web/src/api"
    ]
}
