        { "name": "notes", "sql_type": "text", "udt_name": "text", "nullable": true, "ordinal": 13 },
        { "name": "status", "sql_type": "lesson_status", "udt_name": "lesson_status", "nullable": false, "ordinal": 14, "enum_type": "lesson_status" },
