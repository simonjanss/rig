        { "name": "lesson_tenant_starts_idx", "columns": ["tenant_id", "starts_at"], "method": "btree" },
        { "name": "lesson_snapshot_idx", "columns": ["snapshot_from_lesson_id"], "method": "btree" }
      ],
      "checks": [
        {
          "name": "lesson_version_type_check",
          "expression": "((version_type = 'Original' AND snapshot_from_lesson_id IS NULL) OR (version_type = 'Snapshot' AND snapshot_from_lesson_id IS NOT NULL))"
        }
      ]
