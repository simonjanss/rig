      "patch": {
        "tags": [
          "Todos"
        ],
        "summary": "Update a Todo.",
        "description": "Only the fields present in the body are changed. A field set to null is cleared; a field left out is left alone.\n\nRequires the `todo.write` permission.",
        "operationId": "updateTodo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifier of the Todo.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/ApiRevision"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
