            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "x-rig-permission": "todo.write"
      }
    },
    "/api/v1/todos/_search": {
      "post": {
        "tags": [
          "Todos"
        ],
        "summary": "Search Todos with filters.",
        "description": "Search Todos with filters.\n\nThe primary form of this operation is `QUERY /api/v1/todos` — a read that carries a body, and so safe and idempotent in a way POST is not. OpenAPI 3.1 cannot describe an operation on the QUERY method, so it is documented here as the POST alias that exists for intermediaries which reject unfamiliar methods. One handler serves both routes and they answer identically.\n\nRequires the `todo.read` permission.",
        "operationId": "searchTodos",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip before the first returned row.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "$ref": "#/components/parameters/ApiRevision"
          }
        ],
        "requestBody": {
          "description": "The request body for Todo.Search.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoSearchBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A page of matching Todos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "x-rig-permission": "todo.read"
      }
    },
