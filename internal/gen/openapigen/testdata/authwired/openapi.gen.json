  "paths": {
    "/api/v1/openapi.json": {
      "get": {
        "tags": [
          "openapi"
        ],
        "summary": "The OpenAPI document, as JSON.",
        "description": "The OpenAPI document, as JSON.\n\nIt is generated from the same compiled schema the routes are, so it cannot describe an endpoint this API does not serve. What the running server answers here is the document that build was generated with, embedded in the binary — so a client reading it is reading this deployment rather than whatever is on a branch.\n\nNo credential is read. What this document says is what every generated client was built against, and a specification nobody may fetch is one nobody can use.",
        "operationId": "getOpenAPIJSON",
        "responses": {
          "200": {
            "description": "This document.",
            "headers": {
              "ETag": {
                "description": "The document's content hash. Send it back as If-None-Match and an unchanged document answers 304 with no body.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "304": {
            "description": "The document has not changed since the ETag sent as If-None-Match was issued."
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/openapi.yaml": {
      "get": {
        "tags": [
          "openapi"
        ],
        "summary": "The OpenAPI document, as YAML.",
        "description": "The OpenAPI document, as YAML.\n\nIt is generated from the same compiled schema the routes are, so it cannot describe an endpoint this API does not serve. What the running server answers here is the document that build was generated with, embedded in the binary — so a client reading it is reading this deployment rather than whatever is on a branch.\n\nNo credential is read. What this document says is what every generated client was built against, and a specification nobody may fetch is one nobody can use.",
        "operationId": "getOpenAPIYAML",
        "responses": {
          "200": {
            "description": "This document.",
            "headers": {
              "ETag": {
                "description": "The document's content hash. Send it back as If-None-Match and an unchanged document answers 304 with no body.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/yaml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The document has not changed since the ETag sent as If-None-Match was issued."
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/todos": {
      "get": {
        "tags": [
          "Todos"
        ],
        "summary": "List Todos.",
        "description": "List Todos.\n\nRequires the `todo.read` permission.",
        "operationId": "listTodos",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip before the first returned row.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "$ref": "#/components/parameters/ApiRevision"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of Todos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "x-rig-permission": "todo.read"
      },
      "post": {
        "tags": [
          "Todos"
        ],
        "summary": "Create a Todo.",
        "description": "Create a Todo.\n\nRequires the `todo.write` permission.",
        "operationId": "createTodo",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiRevision"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "description": "The fields a new Todo is created with. A field the database cannot supply for itself is required.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoCreateInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The created Todo.",
