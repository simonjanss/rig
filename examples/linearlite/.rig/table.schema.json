{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.dev/schema/table.v1.json",
  "$defs": {
    "Access": {
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "tenant",
            "own"
          ],
          "description": "Default read width: tenant (every row) or own (rows the caller created)."
        },
        "owner": {
          "type": "string",
          "description": "Column an owner-scoped read filters on. Defaults to created_by_account_id. Must be a NOT NULL uuid referencing rig_account."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Column": {
      "properties": {
        "comment": {
          "type": "string",
          "description": "What this column holds."
        },
        "field": {
          "type": "string",
          "description": "API field name. Defaults to the column name in PascalCase."
        },
        "format": {
          "type": "string",
          "enum": [
            "EmailAddress",
            "URL",
            "PhoneNumber",
            "Color",
            "CountryCode",
            "LanguageCode",
            "TimeZone",
            "RichText"
          ],
          "description": "Semantic format of a string column."
        },
        "go_type": {
          "type": "string",
          "description": "Named Go type for a jsonb column."
        },
        "operations": {
          "items": {
            "type": "string",
            "enum": [
              "Create",
              "Read",
              "Update"
            ]
          },
          "type": "array",
          "description": "Operations this column takes part in. Replaces the default set entirely."
        },
        "immutable": {
          "type": "boolean",
          "description": "Settable on create, never on update."
        },
        "read_only": {
          "type": "boolean",
          "description": "Never writable through the API."
        },
        "exclude": {
          "type": "boolean",
          "description": "Do not expose this column at all."
        },
        "snapshot_ignore": {
          "type": "boolean",
          "description": "Keep the live value when restoring a snapshot."
        },
        "example": {
          "type": "string",
          "description": "Example value for documentation."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Electric": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Expose a live-sync shape endpoint for this table."
        },
        "auth": {
          "type": "string",
          "enum": [
            "tenant",
            "admin"
          ],
          "description": "Session kind required to subscribe."
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/ElectricParam"
          },
          "type": "object",
          "description": "Extra query parameters, keyed by query-string key."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ElectricParam": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Bool",
            "Int",
            "Int64",
            "Float64",
            "String",
            "UUID",
            "Date",
            "Time",
            "Timestamp"
          ],
          "description": "Parameter type."
        },
        "optional": {
          "type": "boolean",
          "description": "Whether the parameter may be omitted."
        },
        "description": {
          "type": "string",
          "description": "What this parameter narrows."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "Endpoint": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Method name on the generated service interface."
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "QUERY"
          ],
          "description": "HTTP method."
        },
        "path": {
          "type": "string",
          "description": "Path relative to the resource, for example /{id}/_publish."
        },
        "summary": {
          "type": "string",
          "description": "One-line description."
        },
        "description": {
          "type": "string",
          "description": "Longer description."
        },
        "permission": {
          "type": "string",
          "description": "RBAC permission key required to call this endpoint."
        },
        "public": {
          "type": "boolean",
          "description": "Answer this endpoint without requiring a credential."
        },
        "request": {
          "$ref": "#/$defs/EndpointRequest",
          "description": "What the client sends."
        },
        "responses": {
          "items": {
            "$ref": "#/$defs/EndpointResponse"
          },
          "type": "array",
          "description": "Every status this endpoint can return."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "method"
      ]
    },
    "EndpointRequest": {
      "properties": {
        "path_params": {
          "items": {
            "$ref": "#/$defs/Param"
          },
          "type": "array",
          "description": "Parameters interpolated into the path."
        },
        "query_params": {
          "items": {
            "$ref": "#/$defs/Param"
          },
          "type": "array",
          "description": "Query-string parameters."
        },
        "body": {
          "items": {
            "$ref": "#/$defs/Param"
          },
          "type": "array",
          "description": "Body fields. Mutually exclusive with body_object."
        },
        "body_object": {
          "type": "string",
          "description": "Name of an object to use as the whole body."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EndpointResponse": {
      "properties": {
        "status": {
          "type": "integer",
          "maximum": 599,
          "minimum": 100,
          "description": "HTTP status code."
        },
        "description": {
          "type": "string",
          "description": "When this status is returned."
        },
        "body_object": {
          "type": "string",
          "description": "Name of the object returned."
        },
        "body_fields": {
          "items": {
            "$ref": "#/$defs/Param"
          },
          "type": "array",
          "description": "Inline body fields. Mutually exclusive with body_object."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status"
      ]
    },
    "Enum": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Generated type name. Defaults to the enum type name in PascalCase."
        },
        "description": {
          "type": "string",
          "description": "What this enumeration represents."
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/EnumValue"
          },
          "type": "object",
          "description": "Per-label configuration keyed by the Postgres label."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EnumValue": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Generated identifier. Defaults to the label in PascalCase."
        },
        "description": {
          "type": "string",
          "description": "What this value means."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OnDelete": {
      "properties": {
        "order": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Child tables in the order they are told about a delete. Anything unlisted runs after."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Param": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Field name in PascalCase."
        },
        "type": {
          "type": "string",
          "description": "Primitive type, or the name of an enum or object."
        },
        "description": {
          "type": "string",
          "description": "What this parameter does."
        },
        "optional": {
          "type": "boolean",
          "description": "Whether the parameter may be omitted."
        },
        "array": {
          "type": "boolean",
          "description": "Whether the parameter is a list."
        },
        "default": {
          "type": "string",
          "description": "Default value when omitted."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "type"
      ]
    },
    "Relation": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the relation on the resource."
        },
        "embed": {
          "type": "boolean",
          "description": "Include the related rows in read responses."
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "properties": {
    "table": {
      "type": "string",
      "description": "The physical table name this file configures."
    },
    "resource": {
      "type": "string",
      "description": "API resource name. Defaults to the table name in PascalCase."
    },
    "plural": {
      "type": "string",
      "description": "Plural resource name. Defaults to an inflection of the resource name."
    },
    "path_segment": {
      "type": "string",
      "description": "URL path segment. Defaults to the kebab-case plural."
    },
    "comment": {
      "type": "string",
      "description": "What this table is for and why it exists."
    },
    "operations": {
      "items": {
        "type": "string",
        "enum": [
          "Create",
          "Get",
          "List",
          "Search",
          "Update",
          "Delete"
        ]
      },
      "type": "array",
      "description": "Operations to expose. Replaces the default set entirely."
    },
    "public": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Operations and endpoints that answer without a credential."
    },
    "expose": {
      "type": "boolean",
      "description": "Expose this table through the API. Defaults to true. False still generates the model and repository."
    },
    "order_by": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Default ordering by column name. Prefix with - for descending."
    },
    "restore_window_days": {
      "type": "integer",
      "description": "Days a soft-deleted row stays restorable. Required when the table has deleted_at."
    },
    "access": {
      "$ref": "#/$defs/Access",
      "description": "How wide a read of this table reaches by default."
    },
    "on_delete": {
      "$ref": "#/$defs/OnDelete",
      "description": "The order tables referencing this one are told about a delete."
    },
    "columns": {
      "additionalProperties": {
        "$ref": "#/$defs/Column"
      },
      "type": "object",
      "description": "Per-column configuration keyed by physical column name."
    },
    "enums": {
      "additionalProperties": {
        "$ref": "#/$defs/Enum"
      },
      "type": "object",
      "description": "Per-enum configuration keyed by Postgres enum type name."
    },
    "relations": {
      "additionalProperties": {
        "$ref": "#/$defs/Relation"
      },
      "type": "object",
      "description": "Per-relation configuration keyed by the related table name."
    },
    "electric": {
      "$ref": "#/$defs/Electric",
      "description": "Live-sync shape endpoint for this table."
    },
    "endpoints": {
      "items": {
        "$ref": "#/$defs/Endpoint"
      },
      "type": "array",
      "description": "Endpoints beyond the generated CRUD set."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "table"
  ],
  "title": "rig table configuration",
  "description": "Configuration for one table: documentation, exposed operations, field naming, and any endpoints beyond the generated CRUD set."
}
